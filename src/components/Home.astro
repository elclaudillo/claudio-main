---
import '../styles/site.css';
import WorkGrid from './WorkGrid.astro';
import { getCollection, render } from 'astro:content';
import {
  langOrder, langNames, langFullNames, socialLinks, defaultLang, LIVE_CHANNEL,
  langPath, strings, works as getWorks, heroWorks, img,
} from '../lib/site.js';

interface Props { lang: string }
const { lang } = Astro.props;
const t = await strings(lang);
// Selected Media: link groups and expandable documents, in dashboard order.
const byOrder = (a, b) => a.data.order - b.data.order;
const mediaGroups = (await getCollection('media')).sort(byOrder).map((e) => e.data);
const mediaDocs = await Promise.all((await getCollection('mediaDocs')).sort(byOrder)
  .map(async (e) => ({ title: e.data.title, Content: (await render(e)).Content })));
const works = await getWorks(lang);
const featured = heroWorks(works);
// Nothing featured: fall back to every visible work rather than an empty hero.
const hero = (featured.length ? featured : works).map((w) => ({ id: w.id, video: w.video, variants: w.variants }));
const byId = Object.fromEntries(works.map((w) => [w.id, w]));
// idx = position in pageData.works, shared by both grids and the modal.
const items = works.map((work, idx) => ({ idx, work }));
const selected = items.filter((i) => i.work.section === 'selected');
const other = items.filter((i) => i.work.section === 'other');
// Watercolors get their own section (first in the Works menu) right after Selected
// Works; the rest of Other work is split by category (no category counts as
// generative). Empty categories are left out of the page and the Works menu.
const watercolours = other.filter((i) => i.work.category === 'watercolour');
const categories = [
  { id: 'clocks', key: 'clock', label: t.catClock },
  { id: 'generative', key: 'generative', label: t.catGenerative },
  { id: 'portraits', key: 'portrait', label: t.catPortrait },
  { id: 'prints', key: 'print', label: t.catPrint },
].map((c) => ({ ...c, items: other.filter((i) => i.work.category === c.key) }))
  .filter((c) => c.items.length);
const firstHero = hero[0];

const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const canonical = site + langPath(lang);
const title = 'Claudio Castillo — Non-Repeating Generative Art';
const description = 'Claudio Castillo — generative watercolour artist. Functional clocks and ever-evolving artworks built from hand-painted watercolours, animation and software.';

// Everything the browser script needs; card text is also rendered as HTML.
const pageData = {
  channel: LIVE_CHANNEL,
  hero,
  works: works.map((w) => ({
    id: w.id, title: w.title, year: w.year, video: w.video, variants: w.variants,
    modalMedium: w.modalMedium, modalExtra: w.modalExtra || '', seriesLink: w.seriesLink || '',
  })),
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script is:inline>
    // Theme before first paint: saved choice, else the system setting.
    (function () {
      var t = null;
      try { t = localStorage.getItem('cc-theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#0b1b33">
  <link rel="canonical" href={canonical}>
  {langOrder.map((l) => <link rel="alternate" hreflang={l} href={site + langPath(l)}>)}
  <link rel="alternate" hreflang="x-default" href={site + langPath(defaultLang)}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={site + img('lg', firstHero.variants[0])}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/icon-192.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="preload" as="image" href={img('lg', firstHero.variants[0])}>
</head>
<body>

<nav class="cc-nav">
  <div class="cc-brand">
    <a href="#top" class="cc-brand-name" aria-label="claudio castillo">
      <iframe src="/ccname/index.html" title="claudio castillo" scrolling="no" tabindex="-1"></iframe>
    </a>
    <p class="cc-tagline">{t.tagline}</p>
  </div>
  <div class="cc-nav-right">
    <ul class="cc-nav-links">
      <li><a href="#about">{t.navAbout}</a></li>
      <li class="cc-menu-wrap">
        <button type="button" aria-expanded="false" aria-controls="works-menu" data-menu-btn>{t.navWorks}</button>
        <div class="cc-menu cc-menu-list cc-menu-works" id="works-menu" hidden>
          <a href="#works">{t.worksHeading}</a>
          {watercolours.length > 0 && <a href="#watercolours">{t.catWatercolour}</a>}
          {categories.map((c) => <a href={`#work-${c.id}`}>{c.label}</a>)}
        </div>
      </li>
    </ul>
    <a class="cc-btn" href="http://api.claudiocastillo.com/admin/" target="_blank" rel="noopener">Login</a>
    <a class="cc-btn cc-live" href="/live/" data-live-btn><span class="cc-live-dot" aria-hidden="true"></span>Live</a>
    <div class="cc-menu-wrap">
      <button class="cc-btn" type="button" aria-label="Contact" aria-expanded="false" aria-controls="contact-menu" data-menu-btn>Contact</button>
      <div class="cc-menu cc-menu-contact" id="contact-menu" hidden>
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>
    <button class="cc-btn cc-theme-btn" type="button" aria-label="Dark mode" title="Dark mode" aria-pressed="false" data-theme-btn>
      <svg class="cc-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.3 22C6.6 22 2 17.4 2 11.7c0-4.4 2.8-8.3 7-9.7.4-.1.8 0 1 .3.3.3.3.7.2 1.1-.4 1-.6 2.1-.6 3.2 0 5 4 9 9 9 1.1 0 2.2-.2 3.2-.6.4-.1.8-.1 1.1.2.3.3.4.7.3 1-1.4 4.2-5.3 7-9.7 7Z"/></svg>
      <svg class="cc-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-15a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 17.5a1 1 0 0 1 1 1V21a1 1 0 1 1-2 0v-.5a1 1 0 0 1 1-1ZM4.2 4.2a1 1 0 0 1 1.4 0l1.1 1.1a1 1 0 0 1-1.4 1.4L4.2 5.6a1 1 0 0 1 0-1.4Zm13.1 13.1a1 1 0 0 1 1.4 0l1.1 1.1a1 1 0 0 1-1.4 1.4l-1.1-1.1a1 1 0 0 1 0-1.4ZM2 12a1 1 0 0 1 1-1h1.5a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1Zm17.5 0a1 1 0 0 1 1-1H21a1 1 0 1 1 0 2h-.5a1 1 0 0 1-1-1ZM4.2 19.8a1 1 0 0 1 0-1.4l1.1-1.1a1 1 0 0 1 1.4 1.4l-1.1 1.1a1 1 0 0 1-1.4 0ZM17.3 6.7a1 1 0 0 1 0-1.4l1.1-1.1a1 1 0 1 1 1.4 1.4l-1.1 1.1a1 1 0 0 1-1.4 0Z"/></svg>
    </button>
    <div class="cc-menu-wrap">
      <button class="cc-btn cc-lang-btn" type="button" aria-label="Language" title="Language" aria-expanded="false" aria-controls="lang-menu" data-menu-btn>{langNames[lang]}</button>
      <div class="cc-menu cc-menu-lang" id="lang-menu" hidden>
        {langOrder.map((l) => (
          <a href={langPath(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{langFullNames[l]}</a>
        ))}
      </div>
    </div>
  </div>
</nav>

<div id="top" class="cc-top">
  <div class="cc-hero">
    <img class="cc-hero-prev" alt="" aria-hidden="true" data-hero-prev>
    <a class="cc-hero-link" href={firstHero.video} target="_blank" rel="noopener" data-hero-link>
      <img class="cc-hero-cur" src={img('lg', firstHero.variants[0])} alt={byId[firstHero.id].title} fetchpriority="high" data-hero-cur>
    </a>
  </div>
</div>

<section id="works" class="cc-works">
  <div class="cc-heading">
    <h2>{t.worksHeading}</h2>
    <div class="cc-rule"></div>
  </div>
  <WorkGrid items={selected} playVideo={t.playVideo} />
</section>

{watercolours.length > 0 && (
  <section id="watercolours" class="cc-works cc-other-works">
    <div class="cc-heading">
      <h2>{t.catWatercolour}</h2>
      <div class="cc-rule"></div>
    </div>
    <WorkGrid items={watercolours} playVideo={t.playVideo} limit={12} showAll={t.showAll} />
  </section>
)}

{categories.length > 0 && (
  <section id="other-work" class="cc-works cc-other-works">
    <div class="cc-heading">
      <h2>{t.otherWork}</h2>
      <div class="cc-rule"></div>
    </div>
    {categories.map((c) => (
      <div id={`work-${c.id}`} class="cc-category">
        <h3 class="cc-category-heading">{c.label}</h3>
        <WorkGrid items={c.items} playVideo={t.playVideo} limit={12} showAll={t.showAll} />
      </div>
    ))}
  </section>
)}

<section id="about" class="cc-about">
  <div class="cc-heading">
    <h2>{t.aboutHeading}</h2>
    <div class="cc-rule"></div>
  </div>
  <div class="cc-about-body">
    {t.about.map((p, i) => (
      <>
        <p class={i === 0 ? 'cc-about-lead' : undefined}>{p}</p>
        {i === 1 && t.aboutQuote && (
          <blockquote class="cc-about-quote">
            <p>{t.aboutQuote}</p>
            {t.aboutQuoteAuthor && <cite>— {t.aboutQuoteAuthor}</cite>}
          </blockquote>
        )}
      </>
    ))}
    <div class="cc-media">
      <span class="cc-media-label">{t.selectedMedia}</span>
      {mediaGroups.filter((g) => g.layout === 'row').map((g) => (
        <div class="cc-media-links">
          {g.items.map((i) => <a href={i.url} target="_blank" rel="noopener">{i.label}&nbsp;→</a>)}
        </div>
      ))}
      <div class="cc-media-groups">
        {mediaGroups.filter((g) => g.layout === 'list').map((g) => (
          <div class="cc-media-group">
            <h4>{g.title}</h4>
            <ul>
              {g.items.map((i) => (
                <li>
                  <a href={i.url} target="_blank" rel="noopener">
                    {i.source && <span class="cc-media-source">{i.source}</span>}
                    <span class="cc-media-title">{i.label}&nbsp;→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {mediaDocs.length > 0 && (
        <div class="cc-docs">
          {mediaDocs.map(({ title, Content }) => (
            <details class="cc-doc">
              <summary>{title}</summary>
              <div class="cc-doc-body"><Content /></div>
            </details>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<footer class="cc-footer">
  <div class="cc-footer-social">
    {socialLinks.map((s) => (
      <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
      </a>
    ))}
  </div>
  <p class="cc-install">{t.installNote}</p>
</footer>

<a class="cc-to-top" href="#top" aria-label={t.backToTop} title={t.backToTop} data-to-top>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.6 4.3 13.3l1.4 1.4L11 9.4V19h2V9.4l5.3 5.3 1.4-1.4z"/></svg>
</a>

<div class="cc-overlay" hidden data-overlay>
  <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="cc-modal-img">
      <a href="#" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" data-m-video-cover></a>
      <img alt="" data-m-img>
    </div>
    <div class="cc-modal-body">
      <button class="cc-close" type="button" aria-label="Close" data-close>×</button>
      <div class="cc-title-row">
        <h3 id="modal-title" data-m-title></h3>
        <span class="cc-year" data-m-year></span>
      </div>
      <div class="cc-modal-medium" data-m-medium></div>
      <div class="cc-modal-extra" data-m-extra></div>
      <a class="cc-series" href="#" target="_blank" rel="noopener" data-m-series>{t.seriesLinkLabel}</a>
      <a class="cc-modal-play" href="#" target="_blank" rel="noopener" data-m-video>{t.playVideo}</a>
    </div>
  </div>
</div>

<script type="application/json" id="cc-data" set:html={JSON.stringify(pageData).replace(/</g, '\\u003c')}></script>
<script>
  import { initHome } from '../scripts/home.js';
  initHome(JSON.parse(document.getElementById('cc-data')!.textContent!));
</script>
</body>
</html>
