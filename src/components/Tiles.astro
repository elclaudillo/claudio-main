---
// A nav label spelled in the old site's coloured letter tiles (see Logo.astro;
// styles under "Logo" in site.css). Letters fly in on load, then settle grey;
// hovering the link brings the colours back. Arabic and Hindi letters join or
// stack, so those labels stay whole, in one tile.
interface Props { text: string; lang: string; offset?: number }
const { text, lang, offset = 0 } = Astro.props;
const palette = ['#2e629b', '#4f7c46', '#90422d', '#8d2129', '#e1d620', '#d85225', '#b3161f', '#53b616'];
const whole = lang === 'ar' || lang === 'hi';
const letters = whole ? [text] : [...new Intl.Segmenter(lang, { granularity: 'grapheme' }).segment(text)].map((s) => s.segment);
---
<span class="cc-word cc-tiles is-active" aria-hidden="true">
  {letters.map((ch, i) => <span class:list={[whole && 'is-whole']} style={`--c:${palette[(i + offset) % palette.length]}`}>{ch === ' ' ? ' ' : ch}</span>)}
</span>
