---
// Stream settings come from /admin (src/data/live.json).
import { LIVE_CHANNEL, LIVE_VIDEO } from '../../lib/site.js';
const liveConfig = JSON.stringify({ channel: LIVE_CHANNEL, video: LIVE_VIDEO }).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Live — Claudio Castillo</title>
<meta name="description" content="Live from Claudio Castillo. Grab the second you are watching.">
<link rel="icon" href="/icon-192.png" type="image/png">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style is:inline>
  html, body { margin:0; height:100%; background:#000; overflow:hidden; }
  * { box-sizing:border-box; }
  body { font-family:'Inter',system-ui,sans-serif; color:#f2ede3; }
  a { color:#d8a83f; }
  a:hover { color:#f0c96a; }
  button { font-family:inherit; }
  .bar { position:relative; z-index:40; flex-shrink:0; display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:4px 18px; background:#0e223f; }
  .brand { display:inline-flex; align-items:center; gap:6px; font-weight:600; font-size:.74rem; text-transform:lowercase; text-decoration:none; color:#f2ede3; letter-spacing:-.01em; }
  .brand:hover { color:#f0c96a; }
  .icobtn { cursor:pointer; display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; padding:0; border:none; background:none; color:#c9c2ac; }
  .icobtn:hover { color:#f0c96a; }
  .icobtn svg { width:17px; height:17px; fill:currentColor; }
  .tag { font-size:.55rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; padding:5px 10px; border-radius:2px; color:#fff; }
  .live { background:#c0271c; animation:pulse 2.4s ease-in-out infinite; }
  .off { background:#514c45; }
  @keyframes pulse { 0%,100%{background-color:#c0271c; box-shadow:0 0 0 0 rgba(192,39,28,.7);} 50%{background-color:#ff3b28; box-shadow:0 0 0 9px rgba(192,39,28,0);} }
  @keyframes flash { from{opacity:.9;} to{opacity:0;} }
  .btn { cursor:pointer; display:inline-flex; align-items:center; gap:8px; font-size:.6rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; text-decoration:none; padding:8px 13px; border-radius:2px; color:#c9c2ac; border:1px solid rgba(201,194,172,.45); background:none; }
  .btn:hover { border-color:#f0c96a; color:#f0c96a; }
  .btn.grab { min-width:84px; justify-content:center; padding:8px 13px; }
  .btn:active, .btn.grab:active { background:#f2ede3; color:#12110f; border-color:transparent; transform:translateY(1px); }
  #printSheet { display:none; }
  @page { margin:10mm; }
  @media (max-width: 640px) {
    /* Stage takes exactly the video's height, so no black band is left over. */
    #stage { flex:0 0 auto !important; height:auto !important; aspect-ratio:16/9; }
    #caption { padding:5px 12px 0 !important; }
    footer { gap:5px !important; padding:5px 10px calc(12px + env(safe-area-inset-bottom)) !important; }
    /* Actions first and on one line; navigation drops underneath. */
    #navrow { flex-wrap:wrap !important; gap:7px !important; }
    #printTopBtn { order:1; }
    #grabBtn { order:2; }
    #rowbreak { display:block; flex-basis:100%; height:0; order:3; }
    #navHome { order:4; }
    #navAbout { order:5; }
    #navWorks { order:6; }
    #socials { order:7; gap:0 !important; }
    #strapline { display:none; }
    .btn, .btn.grab { min-width:0; padding:9px 12px; font-size:.58rem; letter-spacing:.07em; }
  }
  @media print {
    html, body { background:#fff !important; height:auto !important; overflow:visible !important; }
    body > *:not(#printSheet) { display:none !important; }
    #printSheet { display:block !important; }
    #printSheet img { display:block; width:100%; height:auto; }
  }
</style>
</head>
<body>
<div style="position:fixed; inset:0; height:100dvh; background:#000; display:flex; flex-direction:column;">

  <div class="bar">
    <a class='brand' href='/'><span style="font-size:.88rem; line-height:1;">←</span>claudio castillo</a>
    <div style="margin-left:auto; display:flex; align-items:center; gap:10px;">
      <button class="icobtn" id="soundBtn" title="Turn sound on" aria-label="Turn sound on">
        <svg viewBox="0 0 24 24"><path id="soundPath" d="M16.5 12A4.5 4.5 0 0 0 14 7.97v8.05A4.47 4.47 0 0 0 16.5 12zM3 9v6h4l5 5V4L7 9H3zm16.73 3 2.14-2.14-1.41-1.41L18.32 10.6l-2.15-2.15-1.41 1.42L16.91 12l-2.15 2.14 1.41 1.41 2.15-2.14 2.14 2.14 1.41-1.41L19.73 12z"></path></svg>
      </button>
      <button class="icobtn" id="setupBtn" title="Set the stream" aria-label="Set the stream" style="display:none;">
        <svg viewBox="0 0 24 24"><path d="M19.14 12.94a7.07 7.07 0 0 0 .05-.94 7.07 7.07 0 0 0-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84a.48.48 0 0 0-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87a.48.48 0 0 0 .12.61l2.03 1.58a7.6 7.6 0 0 0 0 1.88l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.3.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.04.24.24.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.12-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z"></path></svg>
      </button>
      <span class="tag off" id="statusTag">Off air</span>
    </div>
  </div>

  <div id="stage" style="position:relative; z-index:0; flex:1; min-height:0; background:#000; overflow:hidden;">
    <img id="poster" alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain; object-position:top center; display:none; background:#000;">
    <div style="position:absolute; top:0; left:0; right:0; margin:0 auto; aspect-ratio:16/9; max-width:100%; max-height:100%; overflow:hidden;">
      <iframe id="frame" title="Live stream" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen style="position:absolute; inset:0; width:100%; height:100%; border:0; display:block; pointer-events:none;"></iframe>
    </div>
    <p id="stageMsg" style="display:none; position:absolute; inset:0; z-index:3; margin:0; display:none; align-items:center; justify-content:center; text-align:center; font-size:.68rem; letter-spacing:.06em; color:#8d857a;">Waiting for the broadcast…</p>
    <div id="flash" style="display:none; position:absolute; inset:0; background:#fff; pointer-events:none;"></div>
  </div>

  <p id="caption" style="flex-shrink:0; z-index:30; margin:0; padding:7px 18px 0; text-align:left; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:.62rem; line-height:1.4; letter-spacing:.02em; color:#c9c2ac; background:#000;">Generative clock streaming live, set to US Eastern, Miami tides</p>
  <footer style="position:relative; z-index:40; flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:3px; padding:4px 5vw calc(4px + env(safe-area-inset-bottom)); background:#0e223f; color:#c9c2ac; text-align:center;">
    <p id="notice" style="display:none; margin:0; font-size:.7rem; line-height:1.5; font-weight:600; color:#ffb3ab; max-width:46ch;"></p>
    <div id="navrow" style="display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap;">
      <a class='btn' href='/' id='navHome'><span style="font-size:.95rem; line-height:1;">←</span>Home</a>
      <a class='btn' href='/#about' id='navAbout'>About</a>
      <a class='btn' href='/#works' id='navWorks'>Works</a>
      <button class="btn grab" id="printTopBtn" >Print</button>
      <button class="btn grab" id="grabBtn">Free Grab</button>
      <span id="rowbreak" style="display:none;"></span>
    </div>
    <div id="socials" style="display:flex; align-items:center; gap:4px; flex-wrap:wrap; justify-content:center;"></div>
    <p id="strapline" style="margin:0; font-size:.66rem; letter-spacing:.04em; color:#c9c2ac;">One click saves the second you are watching <span style="opacity:.5;">· build 12</span></p>
  </footer>
</div>



<!-- stream setup -->
<div id="setup" style="display:none; position:fixed; inset:0; z-index:9; background:rgba(4,10,20,.82); align-items:center; justify-content:center; padding:20px;">
  <div style="width:min(460px,100%); background:#0a1a30; border:1px solid rgba(201,194,172,.3); border-radius:4px; padding:22px;">
    <h2 style="margin:0 0 6px; font-size:.78rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#f2ede3;">Set the stream</h2>
    <p style="margin:0 0 14px; font-size:.72rem; line-height:1.6; color:#8d857a;">Paste the YouTube link (or video id) of the broadcast. Leave it empty to follow whatever is live on the channel.</p>
    <input id="setupInput" type="text" placeholder="https://www.youtube.com/watch?v=…" style="width:100%; padding:11px 12px; font-family:ui-monospace,Menlo,monospace; font-size:.75rem; color:#f2ede3; background:#06111f; border:1px solid rgba(201,194,172,.35); border-radius:2px;">
    <p id="setupNote" style="margin:9px 0 0; font-size:.66rem; color:#8d857a;"></p>
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px;">
      <button class="btn solid" id="setupSave">Use this stream</button>
      <button class="btn" id="setupAuto">Follow channel</button>
      <button class="btn" id="setupCancel" style="margin-left:auto;">Cancel</button>
    </div>
  </div>
</div>

<div id="printSheet"><img alt=""></div>

<script type="application/json" id="live-config" set:html={liveConfig}></script>
<script is:inline>
