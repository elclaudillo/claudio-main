  ];
  var sHtml = '';
  socials.forEach(function (s) {
    sHtml += '<a href="' + s[1] + '" target="_blank" rel="noopener" aria-label="' + s[0] + '" class="icobtn" style="width:26px;height:26px;"><svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:currentColor;"><path d="' + s[2] + '"></path></svg></a>';
  });
  $('socials').innerHTML = sHtml;

  // ---- which video ------------------------------------------------------
  function parseId(raw) {
    if (!raw) return '';
    raw = raw.trim();
    if (/^[\w-]{11}$/.test(raw)) return raw;
    var m = raw.match(/[?&]v=([\w-]{11})/) || raw.match(/youtu\.be\/([\w-]{11})/) ||
            raw.match(/\/live\/([\w-]{11})/) || raw.match(/\/embed\/([\w-]{11})/) ||
            raw.match(/\/shorts\/([\w-]{11})/);
    return m ? m[1] : '';
  }
  // Deliberately NOT persisted: the page must always follow whatever is live
  // on the channel after a reload. The gear is a temporary override only.
  function stored() { try { localStorage.removeItem(KEY); } catch (e) {} return ''; }
  var qs = new URLSearchParams(location.search);
  var qId = parseId(qs.get('v') || '');
  if (qs.get('v') === '' || qs.get('auto') === '1') { try { localStorage.removeItem(KEY); } catch (e) {} }

  // The gear is yours, not the audience's: it appears only after visiting
  // /live/?admin=lunation once (remembered), and hides again with ?admin=0.
  var ADMIN_KEY = 'lunation', ADMIN_FLAG = 'ccLiveAdmin';
  var adminParam = qs.get('admin');
  var admin = false;
  try {
    if (adminParam === ADMIN_KEY) { localStorage.setItem(ADMIN_FLAG, '1'); }
    else if (adminParam === '0') { localStorage.removeItem(ADMIN_FLAG); }
    admin = localStorage.getItem(ADMIN_FLAG) === '1';
  } catch (e) { admin = adminParam === ADMIN_KEY; }
  if (admin) $('setupBtn').style.display = 'inline-flex';

  // ?v= wins, then the broadcast pinned in /admin, else follow the channel.
  var pinned = qId || parseId(CONFIG.video || '') || stored();
  var playerId = pinned;   // best-known live video id

  // localhost included so the stream also plays under `npm run dev`.
  var REAL_HOST = /(^|\.)claudiocastillo\.com$|netlify\.app$|^localhost$|^127\.0\.0\.1$/.test(location.hostname);
  var ORIGIN = encodeURIComponent(location.protocol + '//' + location.host);
  var COMMON = 'autoplay=1&mute=1&rel=0&playsinline=1&enablejsapi=1&controls=0&modestbranding=1' +
               '&iv_load_policy=3&fs=0&disablekb=1' +
               (REAL_HOST ? '&origin=' + ORIGIN + '&widget_referrer=' + ORIGIN : '');
  function embedSrc() {
    var base = pinned
      ? 'https://www.youtube.com/embed/' + pinned + '?'
      : 'https://www.youtube.com/embed/live_stream?channel=' + CHANNEL + '&';
    return base + COMMON;
  }
  function watchUrl() {
    return pinned ? 'https://www.youtube.com/watch?v=' + pinned
                  : 'https://www.youtube.com/channel/' + CHANNEL + '/live';
  }
  function loadStream() {
    playerId = pinned;
    player = null;
    if (!REAL_HOST) {
      $('frame').removeAttribute('src');
      $('frame').style.visibility = 'hidden';
      $('stageMsg').textContent = 'Preview mode — the live stream plays on claudiocastillo.com';
      $('stageMsg').style.display = 'flex';
      return;
    }
    showEmbed(embedSrc());
    refreshPoster();
    if (!pinned) resolveChannelLive();
  }

  // YouTube's live_stream?channel= embed is unreliable, so ask the channel's
  // live page (through the Netlify proxy) which video is actually on air and
  // re-point the player at that id.
  var FALLBACK_ID = 'GZ2NM3WH0Mk';
  function resolveChannelLive() {
    fetch('/livecheck/' + Date.now() + '/' + CHANNEL, { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
      .then(function (t) {
        // Current page format: live only if the view counter says so, and the
        // broadcast is the watch page's own video (currentVideoEndpoint).
        var watching = /"videoViewCountRenderer":\{[\s\S]{0,400}?"isLive":true/.test(t);
        var m = (watching && t.match(/"currentVideoEndpoint":\{[\s\S]{0,600}?"watchEndpoint":\{"videoId":"([\w-]{11})"/))
             || t.match(/<link\s+rel="canonical"\s+href="[^"]*[?&]v=([\w-]{11})/i)
             || t.match(/"videoDetails"\s*:\s*\{[^}]*?"videoId"\s*:\s*"([\w-]{11})"/)
             || t.match(/"isLiveNow"\s*:\s*true[\s\S]{0,4000}?"videoId"\s*:\s*"([\w-]{11})"/)
             || t.match(/"videoId"\s*:\s*"([\w-]{11})"[\s\S]{0,2000}?"isLiveNow"\s*:\s*true/);
        if (!m) return;
        var id = m[1];
        if (id === playerId) return;
        playerId = id;
        showEmbed('https://www.youtube.com/embed/' + id + '?' + COMMON);
        refreshPoster();
      })
      .catch(function () {
        // No proxy (preview, local file only): show the last known broadcast.
        if (REAL_HOST) return;
        if (validId(FALLBACK_ID) && playerId !== FALLBACK_ID) {
          playerId = FALLBACK_ID;
          showEmbed('https://www.youtube.com/embed/' + FALLBACK_ID + '?' + COMMON);
          refreshPoster();
        }
      });
  }

  // ---- player -----------------------------------------------------------
  var player = null, muted = true, isLive = false;

  function bindPlayer() {
    var go = function () {
      if (!window.YT || !window.YT.Player) return;
      try {
        player = new window.YT.Player('frame', {
          events: {
            onReady: function (e) {
              var kick = 0;
              var t = setInterval(function () {
                try {
                  e.target.mute();
                  if (e.target.getPlayerState && e.target.getPlayerState() === 1) { clearInterval(t); return; }
                  e.target.playVideo();
                } catch (x) {}
                if (++kick > 12) clearInterval(t);
              }, 500);
              readState();
            },
            onStateChange: function (ev) {
              try {
                if (ev && (ev.data === 1 || ev.data === 3)) clearWaiting();
              } catch (x) {}
              readState();
              try {
                if (ev && (ev.data === 2 || ev.data === 0 || ev.data === 5)) { ev.target.mute(); ev.target.playVideo(); }
              } catch (x) {}
            },
            onError: function (e) {
              if ([101, 150, 153, 2, 5, 100].indexOf(e && e.data) !== -1) {
                embedBlocked();
                if (!pinned) resolveChannelLive();
              }
            }
          }
        });
      } catch (x) {}
    };
    if (window.YT && window.YT.Player) { go(); return; }
    var prev = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = function () { if (prev) prev(); go(); };
    if (!document.querySelector('script[src*="iframe_api"]')) {
      var s = document.createElement('script');
      s.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(s);
    }
  }

  var embedFails = 0, posterTimer = null, playWatch = null;

  // A refused embed (153 / 101 / 150) is only terminal once the directly
  // resolved video id has also failed — the channel embed alone is unreliable.
  function embedBlocked() {
    embedFails++;
    if (embedFails < 2) return;
    $('frame').style.visibility = 'hidden';
    $('stageMsg').style.display = 'flex';
    if (!posterTimer) posterTimer = setInterval(refreshPoster, 5000);
    refreshPoster();
  }

  // Any fresh src gets a clean slate: visible iframe, no fallback showing.
  function showEmbed(src) {
    var f = $('frame');
    f.style.visibility = 'visible';
    $('stageMsg').style.display = 'none';
    if (posterTimer) { clearInterval(posterTimer); posterTimer = null; }
    player = null;
    f.src = src;
    bindPlayer();
    // Some refusals are silent (no onError at all), so a player that never
    // reaches PLAYING gets the same fallback as an explicit error.
    clearTimeout(playWatch);
    playWatch = setTimeout(function () {
      var playing = false;
      try { playing = player && player.getPlayerState && player.getPlayerState() === 1; } catch (e) {}
      if (!playing) { $('stageMsg').style.display = 'flex'; if (!posterTimer) posterTimer = setInterval(refreshPoster, 5000); refreshPoster(); }
    }, 7000);
  }

  function clearWaiting() {
    clearTimeout(playWatch);
    embedFails = 0;
    $('stageMsg').style.display = 'none';
    $('frame').style.visibility = 'visible';
    if (posterTimer) { clearInterval(posterTimer); posterTimer = null; }
    $('poster').style.display = 'none';
  }

  function readState() {
    if (!player) return;
    var live = false;
    try {
      var d = player.getVideoData ? player.getVideoData() : null;
      if (d && d.video_id && d.video_id !== playerId) { playerId = d.video_id; refreshPoster(); }
      if (d && typeof d.isLive === 'boolean') live = d.isLive;
      else if (player.getDuration) live = player.getDuration() === 0;
    } catch (e) {}
    try {
      var st = player.getPlayerState ? player.getPlayerState() : -1;
      var t = player.getCurrentTime ? player.getCurrentTime() : 0;
      if (st === 1 || st === 3 || t > 0) clearWaiting();
    } catch (e) {}
    if (live !== isLive) {
      isLive = live;
      var t = $('statusTag');
      t.textContent = live ? 'On air' : 'Off air';
      t.className = 'tag ' + (live ? 'live' : 'off');
    }
  }

  function validId(v) { return !!v && /^[\w-]{11}$/.test(v) && v !== 'live_stream'; }
  function refreshPoster() {
    var el = $('poster');
    if (!validId(playerId)) { if (!posterTimer) el.style.display = 'none'; return; }
    var sizes = ['maxresdefault_live.jpg', 'sddefault_live.jpg', 'hqdefault_live.jpg', 'hqdefault.jpg'], i = 0, t = Date.now();
    el.onerror = function () { i++; if (i < sizes.length) el.src = 'https://i.ytimg.com/vi/' + playerId + '/' + sizes[i] + '?t=' + t; else if (!posterTimer) el.style.display = 'none'; };
    el.onload = function () { el.style.display = 'block'; };
    el.src = 'https://i.ytimg.com/vi/' + playerId + '/' + sizes[0] + '?t=' + t;
  }

  $('soundBtn').addEventListener('click', function () {
    muted = !muted;
    try { if (player) { muted ? player.mute() : (player.unMute(), player.setVolume(100)); } } catch (e) {}
    $('soundPath').setAttribute('d', muted
      ? 'M16.5 12A4.5 4.5 0 0 0 14 7.97v8.05A4.47 4.47 0 0 0 16.5 12zM3 9v6h4l5 5V4L7 9H3zm16.73 3 2.14-2.14-1.41-1.41L18.32 10.6l-2.15-2.15-1.41 1.42L16.91 12l-2.15 2.14 1.41 1.41 2.15-2.14 2.14 2.14 1.41-1.41L19.73 12z'
      : 'M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05A4.47 4.47 0 0 0 16.5 12zM14 3.23v2.06a6.98 6.98 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z');
    $('soundBtn').title = muted ? 'Turn sound on' : 'Turn sound off';
  });

  // ---- stream setup panel ----------------------------------------------
  function openSetup() {
    $('setupInput').value = pinned ? 'https://www.youtube.com/watch?v=' + pinned : '';
    $('setupNote').textContent = pinned
      ? 'Showing ' + pinned + ' until you reload — the page follows the channel automatically.'
      : 'Following the channel’s current broadcast automatically. You do not need to set anything.';
    $('setup').style.display = 'flex';
    $('setupInput').focus();
  }
  function closeSetup() { $('setup').style.display = 'none'; }
  $('setupBtn').addEventListener('click', function () { if (admin) openSetup(); });
  $('setupCancel').addEventListener('click', closeSetup);
  $('setupSave').addEventListener('click', function () {
    var id = parseId($('setupInput').value);
    if (!id) { $('setupNote').textContent = 'That does not look like a YouTube link or id.'; return; }
    pinned = id;
    closeSetup(); loadStream();
  });
  $('setupAuto').addEventListener('click', function () {
    pinned = '';
    try { localStorage.removeItem(KEY); } catch (e) {}
    closeSetup(); loadStream();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeSetup();
    if (admin && (e.key === 's' || e.key === 'S') && e.target === document.body) openSetup();
  });

  // ---- capture ----------------------------------------------------------
  var capture = null, grabbing = false;

  function stamp() {
    var d = new Date();
    var et = d.toLocaleString('en-US', { timeZone: 'America/New_York', year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    return { et: et + ' ET', second: d.toISOString().slice(0, 19) };
  }
  function fileName(second) { return 'claudiocastillo-live-' + second.replace(/[:T]/g, '-') + '.png'; }
  function notice(msg) { var n = $('notice'); n.textContent = msg || ''; n.style.display = msg ? 'block' : 'none'; }

  function snapUrls() {
    if (!validId(playerId)) return [];
    var t = Date.now() + '-' + Math.random().toString(36).slice(2);
    var files = ['maxresdefault_live.jpg', 'sddefault_live.jpg', 'hqdefault_live.jpg',
                 'maxresdefault.jpg', 'sddefault.jpg', 'hqdefault.jpg', 'mqdefault.jpg'], out = [];
    files.forEach(function (f) { out.push('/snapx/' + t + '/' + playerId + '/' + f + '?nocache=' + t); });
    files.forEach(function (f) { out.push('https://i.ytimg.com/vi/' + playerId + '/' + f + '?nocache=' + t); });
    files.forEach(function (f) { out.push('/snap/' + playerId + '/' + f + '?nocache=' + t); });
    return out;
  }
  function fetchSnap(urls, i) {
    i = i || 0;
    if (i >= urls.length) return Promise.reject(new Error('no snapshot'));
    return fetch(urls[i], { cache: 'reload', mode: 'cors', credentials: 'omit' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.blob(); })
      .then(function (b) {
        if (!b.size || b.size < 1200) throw new Error('empty');
        return new Promise(function (res, rej) {
          var fr = new FileReader();
          fr.onload = function () { res(fr.result); };
          fr.onerror = rej;
          fr.readAsDataURL(b);
        });
      })
      .catch(function () { return fetchSnap(urls, i + 1); });
  }
  function trimBlack(img, w, h) {
    var t = document.createElement('canvas');
    t.width = w; t.height = h;
    var tx = t.getContext('2d');
    tx.drawImage(img, 0, 0);
    var d;
    try { d = tx.getImageData(0, 0, w, h).data; } catch (e) { return { c: t, w: w, h: h }; }
    var dark = function (i) { return d[i] < 26 && d[i + 1] < 26 && d[i + 2] < 26; };
    var rowDark = function (y) {
      for (var xx = 0; xx < w; xx += 2) if (!dark((y * w + xx) * 4)) return false;
      return true;
    };
    var colDark = function (xx) {
      for (var y = 0; y < h; y += 2) if (!dark((y * w + xx) * 4)) return false;
      return true;
    };
    var top = 0, bot = h - 1, left = 0, right = w - 1;
    var maxY = Math.floor(h * 0.4), maxX = Math.floor(w * 0.4);
    while (top < maxY && rowDark(top)) top++;
    while (bot > h - 1 - maxY && rowDark(bot)) bot--;
    while (left < maxX && colDark(left)) left++;
    while (right > w - 1 - maxX && colDark(right)) right--;
    var nw = right - left + 1, nh = bot - top + 1;
    if (nw < w * 0.4 || nh < h * 0.4) return { c: t, w: w, h: h };
    if (nw === w && nh === h) return { c: t, w: w, h: h };
    var o = document.createElement('canvas');
    o.width = nw; o.height = nh;
    o.getContext('2d').drawImage(t, left, top, nw, nh, 0, 0, nw, nh);
    return { c: o, w: nw, h: nh };
  }
  var QR_LIVE = '1111111001000100101111111|1000001011011111101000001|1011101001110010001011101|1011101011010111001011101|1011101000101100101011101|1000001010100011001000001|1111111010101010101111111|0000000000001010100000000|1111101111101100010101010|1011110111000100010101000|1000111011011111101100011|0001110011110010110000001|1000111111010110011010110|1011110010101100110100000|1000101110100011011110011|1001010001001001101000010|1000101011101110111111101|0000000010100101100010000|1111111011011000101011011|1000001000010010100010001|1011101010011111111111100|1011101010001011011011111|1011101010100110100100001|1000001011000001100110001|1111111011001110011111111';
  var QR_SITE = '1111111000101100101111111|1000001010100011001000001|1011101000001001101011101|1011101011101110001011101|1011101001000100101011101|1000001011011111101000001|1111111010101010101111111|0000000001110011000000000|1111101111010100010101010|1111000000101100100100010|1111101000100111000000111|0101110010001001111101010|1111011111101111111011111|1000100010000000100100110|1010101111111101110101111|1011000101110010010100010|1011111100110111111111111|0000000011001100100011010|1111111011100110101010111|1000001001101010100010010|1011101011001111111111111|1011101011100100011110111|1011101011011011000101001|1000001011110011101100001|1111111011011000010001111';
  function drawQr(x, matrix, px, py, cell) {
    var rows = matrix.split('|'), n = rows.length, quiet = 2;
    var side = cell * (n + quiet * 2);
    x.fillStyle = '#fff'; x.fillRect(px, py, side, side);
    x.fillStyle = '#000';
    for (var r = 0; r < n; r++) for (var c = 0; c < n; c++) {
      if (rows[r].charAt(c) === '1') x.fillRect(px + (c + quiet) * cell, py + (r + quiet) * cell, cell, cell);
    }
    return side;
  }
  function caption(img, w0, h0, second, name) {
    var src = trimBlack(img, w0, h0), w = src.w, h = src.h;
    var cell = 2;
    var qr = cell * 29;
    var pad = Math.max(4, Math.round(qr * 0.07));
    var bar = qr + pad * 2;
    var c = document.createElement('canvas');
    c.width = w; c.height = h + bar;
    var x = c.getContext('2d');
    x.imageSmoothingEnabled = false;
    x.drawImage(src.c, 0, 0);
    x.fillStyle = '#fff'; x.fillRect(0, h, w, bar);
    var qx = w - pad - qr, top = h + pad;
    drawQr(x, QR_LIVE, qx, top, cell);
    x.fillStyle = '#000'; x.textBaseline = 'middle';
    var lab = Math.max(9, Math.round(qr * 0.3));
    x.font = lab + 'px ui-monospace, Menlo, monospace';
    x.textAlign = 'right'; x.textBaseline = 'alphabetic';
    x.fillText('live', qx - Math.round(pad * 1.2), top + qr);
    x.textBaseline = 'middle';
    var labW = x.measureText('live').width;
    var l1 = 'A generative clock streaming live set to US Eastern, Miami tides.';
    var l2 = 'Lunation — ' + second + '    Claudio Castillo / Rachel Levy / Yevhen Hetmanov.';
    var edge = qx - labW - pad * 4;
    var fs = Math.max(6, Math.round(bar * 0.3));
    var fit = function (size) {
      x.font = size + 'px ui-monospace, Menlo, monospace';
      return Math.max(x.measureText(l1).width, x.measureText(l2).width);
    };
    while (fs > 6 && fit(fs) > edge) fs--;
    x.font = fs + 'px ui-monospace, Menlo, monospace';
    x.textAlign = 'left'; x.textBaseline = 'alphabetic';
    var lead = Math.round(fs * 1.25);
    var base = h + Math.round((bar + lead + fs * 0.7) / 2);
    x.fillText(l1, pad * 2, base - lead);
    x.fillText(l2, pad * 2, base);
    return c.toDataURL('image/png');
  }
  function flash() {
    var f = $('flash');
    f.style.display = 'block';
    f.style.animation = 'none';
    void f.offsetWidth;
    f.style.animation = 'flash 420ms ease-out forwards';
    setTimeout(function () { f.style.display = 'none'; }, 460);
  }
  function dataToBlob(data) {
    var bin = atob(data.split(',')[1]), arr = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
    return new Blob([arr], { type: 'image/png' });
  }
  function download() {
    if (!capture) return;
    var name = fileName(capture.second);
    var save = function () {
      var a = document.createElement('a');
      a.href = capture.preview; a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
    };
    var ios = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (!ios || !navigator.canShare) { save(); return; }
    try {
      var file = new File([dataToBlob(capture.preview)], name, { type: 'image/png' });
      if (!navigator.canShare({ files: [file] })) { save(); return; }
      navigator.share({ files: [file] }).catch(function (err) { if (!err || err.name !== 'AbortError') save(); });
    } catch (e) { save(); }
  }
  function showCapture() {}

  var lastSig = '';
  function busy(on, btn, label) {
    grabbing = on;
    btn.textContent = on ? label : btn.getAttribute('data-label');
    btn.style.opacity = on ? '.6' : '1';
  }
  function grabFrame(retry) {
    var s = stamp();
    return fetchSnap(snapUrls()).then(function (data) {
      var sameAsLast = (data.length + ':' + data.slice(-96)) === lastSig;
      if (sameAsLast && !retry) {
        return new Promise(function (res) { setTimeout(res, 1400); }).then(function () { return grabFrame(true); });
      }
      var sig = data.length + ':' + data.slice(-96);
      var fresh = sig !== lastSig;
      lastSig = sig;
      return new Promise(function (res) {
        var img = new Image();
        img.onload = function () {
          res({ et: s.et, second: s.second, w: img.naturalWidth, h: img.naturalHeight, fresh: fresh,
                preview: caption(img, img.naturalWidth, img.naturalHeight, s.et, fileName(s.second)) });
        };
        img.onerror = function () { res({ et: s.et, second: s.second, w: 0, h: 0, fresh: fresh, preview: data }); };
        img.src = data;
      });
    });
  }
  function runGrab(btn, label, done) {
    if (grabbing) return;
    if (!validId(playerId)) { notice('No stream loaded yet — set one with the gear icon.'); return; }
    busy(true, btn, label);
    notice('');
    grabFrame()
      .then(function (cap) {
        capture = cap;
        showCapture(); flash();
        done();
      })
      .catch(function () {
        notice(validId(playerId)
          ? 'Could not read a picture from the stream. Try again in a moment.'
          : 'Waiting for the broadcast to be detected — try again in a few seconds.');
      })
      .then(function () { busy(false, btn, label); });
  }
  function printCapture() {
    if (!capture || !capture.preview || capture.preview === BLANK) return;
    var img = $('printSheet').querySelector('img');
    var go = function () { setTimeout(function () { try { window.print(); } catch (e) {} }, 140); };
    if (img.getAttribute('src') !== capture.preview) { img.onload = go; img.onerror = go; img.src = capture.preview; }
    else if (img.decode) { img.decode().then(go).catch(go); } else go();
  }
  $('grabBtn').setAttribute('data-label', 'Free Grab');
  $('printTopBtn').setAttribute('data-label', 'Print');
  $('grabBtn').addEventListener('click', function () {
    runGrab($('grabBtn'), 'Grabbing…', download);
  });
  $('printTopBtn').addEventListener('click', function () {
    runGrab($('printTopBtn'), 'Printing…', printCapture);
  });


  loadStream();
  var quick = setInterval(readState, 1500);
  setTimeout(function () { clearInterval(quick); setInterval(readState, 15000); }, 30000);
  setInterval(refreshPoster, 20000);
  setInterval(function () { if (!pinned && !isLive) resolveChannelLive(); }, 30000);
  setInterval(function () {
    try {
      if (player && player.getPlayerState && player.getPlayerState() !== 1) { if (muted) player.mute(); player.playVideo(); }
    } catch (e) {}
  }, 4000);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) { try { player && player.playVideo(); } catch (e) {} }
  });
})();
</script>
</body>
